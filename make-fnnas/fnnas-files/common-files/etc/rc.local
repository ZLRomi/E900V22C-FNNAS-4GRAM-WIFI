#!/bin/bash
#
# rc.local
#
# This script is executed at the end of each multiuser runlevel.
# Make sure that the script will "exit 0" on success or any other
# value on error.
#
# In order to enable or disable this script just change the execution
# bits.
#
# By default this script does nothing.

# ===== E900V22C (S905L3A) 4G RAM =====
# postgresql 未启用 -> 5666 启动慢（triminit 连库重试 122 秒）+ 依赖服务 panic 循环
# resmon 未启用    -> 资源管理 CPU/内存显示 0
# 注意：start 必须加 --no-block。resmon_service 的 After=rc-local.service，
# 同步 start 会形成“rc.local 等 resmon job，resmon job 等 rc.local 结束”的死锁，
# rc.local 永不退出，trim 全家（After=rc-local）永远起不来，5666 不通。
for _svc in postgresql.service resmon_service.service; do
    if [ -f "/lib/systemd/system/${_svc}" ] || [ -f "/etc/systemd/system/${_svc}" ]; then
        systemctl is-enabled "${_svc}" >/dev/null 2>&1 || systemctl enable "${_svc}" >/dev/null 2>&1 || true
        systemctl is-active  "${_svc}" >/dev/null 2>&1 || systemctl --no-block start "${_svc}" >/dev/null 2>&1 || true
    fi
done

# 内核 OTA 拦截（e900v22c 专用，幂等，只装一次）
# fnnas-update 默认追最新内核，会覆盖 4G dtb 并使 WiFi vermagic 失效；
# 飞牛 Web 的 trim 应用更新不受影响。拦截器源码见
# /usr/lib/fnnas-e900v22c/fnnas-update-wrapper.sh（同版本 -k 放行）。
if [ -f /usr/lib/fnnas-e900v22c/fnnas-update-wrapper.sh ] && [ -f /usr/sbin/fnnas-update ] && [ ! -f /usr/sbin/fnnas-update.real ]; then
    mv /usr/sbin/fnnas-update /usr/sbin/fnnas-update.real 2>/dev/null || true
    install -m 0755 /usr/lib/fnnas-e900v22c/fnnas-update-wrapper.sh /usr/sbin/fnnas-update 2>/dev/null \
        || { cp -f /usr/lib/fnnas-e900v22c/fnnas-update-wrapper.sh /usr/sbin/fnnas-update 2>/dev/null || true; chmod 0755 /usr/sbin/fnnas-update 2>/dev/null || true; }
    logger -t e900v22c "fnnas-update guard installed" 2>/dev/null || true
fi

# FnNAS / ophub 的设备相关初始化（务必最后执行，不能被前面的错误挡住）
[[ -x "/etc/custom_service/start_service.sh" ]] && bash /etc/custom_service/start_service.sh &

exit 0
