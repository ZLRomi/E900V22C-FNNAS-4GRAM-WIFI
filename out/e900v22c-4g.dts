				#size-cells = <0x00>;
				clocks = <0x02 0x18>;
				pinctrl-0 = <0x2a 0x2b>;
				pinctrl-names = "default";
				phandle = <0x130>;
			};

			clk_msr: clock-measure@18000 {
				compatible = "amlogic,meson-g12a-clk-measure";
				reg = <0x00 0x18000 0x00 0x10>;
				phandle = <0x131>;
			};

			uart_C: serial@22000 {
				compatible = "amlogic,meson-g12a-uart", "amlogic,meson-gx-uart";
				reg = <0x00 0x22000 0x00 0x18>;
				interrupts = <0x00 0x5d 0x01>;
				clocks = <0x08 0x02 0x39 0x08>;
				clock-names = "xtal", "pclk", "baud";
				status = "disabled";
				phandle = <0x132>;
			};

			uart_B: serial@23000 {
				compatible = "amlogic,meson-g12a-uart", "amlogic,meson-gx-uart";
				reg = <0x00 0x23000 0x00 0x18>;
				interrupts = <0x00 0x4b 0x01>;
				clocks = <0x08 0x02 0x2a 0x08>;
				clock-names = "xtal", "pclk", "baud";
				status = "disabled";
				phandle = <0x133>;
			};

			uart_A: serial@24000 {
				compatible = "amlogic,meson-g12a-uart", "amlogic,meson-gx-uart";
				reg = <0x00 0x24000 0x00 0x18>;
				interrupts = <0x00 0x1a 0x01>;
				clocks = <0x08 0x02 0x1c 0x08>;
				clock-names = "xtal", "pclk", "baud";
				status = "disabled";
				fifo-size = <0x80>;
				phandle = <0x134>;
			};
		};

		sd_emmc_a: mmc@ffe03000 {
			compatible = "amlogic,meson-axg-mmc";
			reg = <0x00 0xffe03000 0x00 0x800>;
			interrupts = <0x00 0xbd 0x04>;
			status = "okay";
			clocks = <0x02 0x21 0x02 0x3c 0x02 0x02>;
			clock-names = "core", "clkin0", "clkin1";
			resets = <0x05 0x2c>;
			assigned-clocks = <0x02 0x3c>;
			assigned-clock-rates = <0x16e3600>;
			amlogic,dram-access-quirk;
			pinctrl-0 = <0x2c>;
			pinctrl-1 = <0x2d>;
			pinctrl-names = "default", "clk-gate";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			bus-width = <0x04>;
			cap-sd-highspeed;
			sd-uhs-sdr50;
			max-frequency = <0x5f5e100>;
			non-removable;
			disable-wp;
			keep-power-in-suspend;
			mmc-pwrseq = <0x2e>;
			vmmc-supply = <0x2f>;
			vqmmc-supply = <0x0e>;
			phandle = <0x135>;
		};

		sd_emmc_b: mmc@ffe05000 {
			compatible = "amlogic,meson-axg-mmc";
			reg = <0x00 0xffe05000 0x00 0x800>;
			interrupts = <0x00 0xbe 0x04>;
			status = "okay";
			clocks = <0x02 0x22 0x02 0x3d 0x02 0x02>;
			clock-names = "core", "clkin0", "clkin1";
			resets = <0x05 0x2d>;
			assigned-clocks = <0x02 0x3d>;
			assigned-clock-rates = <0x16e3600>;
			pinctrl-0 = <0x30>;
			pinctrl-1 = <0x31>;
			pinctrl-names = "default", "clk-gate";
			bus-width = <0x04>;
			cap-sd-highspeed;
			max-frequency = <0x2faf080>;
			disable-wp;
			cd-gpios = <0x32 0x2f 0x01>;
			vmmc-supply = <0x2f>;
			vqmmc-supply = <0x2f>;
			phandle = <0x136>;
		};

		sd_emmc_c: mmc@ffe07000 {
			compatible = "amlogic,meson-axg-mmc";
			reg = <0x00 0xffe07000 0x00 0x800>;
			interrupts = <0x00 0xbf 0x04>;
			status = "okay";
			clocks = <0x02 0x23 0x02 0x3e 0x02 0x02>;
			clock-names = "core", "clkin0", "clkin1";
			resets = <0x05 0x2e>;
			assigned-clocks = <0x02 0x3e>;
			assigned-clock-rates = <0x16e3600>;
			pinctrl-0 = <0x33 0x34 0x35>;
			pinctrl-1 = <0x36>;
			pinctrl-names = "default", "clk-gate";
			bus-width = <0x08>;
			cap-mmc-highspeed;
			mmc-ddr-1_8v;
			mmc-hs200-1_8v;
			max-frequency = <0x5f5e100>;
			non-removable;
			disable-wp;
			mmc-pwrseq = <0x37>;
			vmmc-supply = <0x38>;
			vqmmc-supply = <0x39>;
			phandle = <0x137>;
		};

		usb: usb@ffe09000 {
			status = "okay";
			compatible = "amlogic,meson-g12a-usb-ctrl";
			reg = <0x00 0xffe09000 0x00 0xa0>;
			interrupts = <0x00 0x10 0x04>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;
			clocks = <0x02 0x2f>;
			resets = <0x05 0x22>;
			dr_mode = "otg";
			phys = <0x3a 0x3b 0x06 0x04>;
			phy-names = "usb2-phy0", "usb2-phy1", "usb3-phy0";
			vbus-supply = <0x3c>;
			phandle = <0x138>;

			dwc2: usb@ff400000 {
				compatible = "amlogic,meson-g12a-usb", "snps,dwc2";
				reg = <0x00 0xff400000 0x00 0x40000>;
				interrupts = <0x00 0x1f 0x04>;
				clocks = <0x02 0x37>;
				clock-names = "otg";
				phys = <0x3b>;
				phy-names = "usb2-phy";
				dr_mode = "peripheral";
				g-rx-fifo-size = <0xc0>;
				g-np-tx-fifo-size = <0x80>;
				g-tx-fifo-size = <0x80 0x80 0x10 0x10 0x10>;
				phandle = <0x139>;
			};

			dwc3: usb@ff500000 {
				compatible = "snps,dwc3";
				reg = <0x00 0xff500000 0x00 0x100000>;
				interrupts = <0x00 0x1e 0x04>;
				dr_mode = "host";
				snps,dis_u2_susphy_quirk;
				snps,quirk-frame-length-adjustment = <0x20>;
				snps,parkmode-disable-ss-quirk;
				phandle = <0x13a>;
			};
		};

		mali: gpu@ffe40000 {
			compatible = "amlogic,meson-g12a-mali", "arm,mali-bifrost";
			reg = <0x00 0xffe40000 0x00 0x40000>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xa2 0x04 0x00 0xa1 0x04 0x00 0xa0 0x04>;
			interrupt-names = "job", "mmu", "gpu";
			clocks = <0x02 0xaf>;
			resets = <0x05 0x14 0x05 0x4e>;
			operating-points-v2 = <0x3d>;
			#cooling-cells = <0x02>;
			mali-supply = <0x3e>;
			phandle = <0x48>;
		};
	};

	thermal-zones {

		cpu_thermal: cpu-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x64>;
			thermal-sensors = <0x3f>;
			phandle = <0x13b>;

			trips {

				cpu_passive: cpu-passive {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x40>;
				};

				cpu_hot: cpu-hot {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "hot";
					phandle = <0x45>;
				};

				cpu_critical: cpu-critical {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0x13c>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x40>;
					cooling-device = <0x41 0xffffffff 0xffffffff 0x42 0xffffffff 0xffffffff 0x43 0xffffffff 0xffffffff 0x44 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0x45>;
					cooling-device = <0x41 0xffffffff 0xffffffff 0x42 0xffffffff 0xffffffff 0x43 0xffffffff 0xffffffff 0x44 0xffffffff 0xffffffff>;
				};
			};
		};

		ddr_thermal: ddr-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x64>;
			thermal-sensors = <0x46>;
			phandle = <0x13d>;

			trips {

				ddr_passive: ddr-passive {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x47>;
				};

				ddr_critical: ddr-critical {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0x13e>;
				};
			};

			cooling-maps {

				map {
					trip = <0x47>;
					cooling-device = <0x48 0xffffffff 0xffffffff>;
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xff08 0x01 0x0e 0xff08 0x01 0x0b 0xff08 0x01 0x0a 0xff08>;
		arm,no-tick-in-suspend;
	};

	xtal: xtal-clk {
		compatible = "fixed-clock";
		clock-frequency = <0x16e3600>;
		clock-output-names = "xtal";
		#clock-cells = <0x00>;
		phandle = <0x08>;
	};

	npu: npu@ff100000 {
		compatible = "vivante,gc";
		reg = <0x00 0xff100000 0x00 0x20000>;
		interrupts = <0x00 0x93 0x04>;
		clocks = <0x02 0x10b 0x02 0x108>;
		clock-names = "core", "bus";
		assigned-clocks = <0x02 0x10b 0x02 0x108>;
		assigned-clock-rates = <0x2faf0800 0x2faf0800>;
		resets = <0x05 0x4c>;
		status = "disabled";
		phandle = <0x13f>;
	};

	tdmif_a: audio-controller-0 {
		compatible = "amlogic,axg-tdm-iface";
		#sound-dai-cells = <0x00>;
		sound-name-prefix = "TDM_A";
		clocks = <0x14 0x4f 0x14 0x56 0x14 0x31>;
		clock-names = "sclk", "lrclk", "mclk";
		status = "okay";
		pinctrl-0 = <0x49 0x4a 0x4b>;
		pinctrl-names = "default";
		phandle = <0x66>;
	};

	tdmif_b: audio-controller-1 {
		compatible = "amlogic,axg-tdm-iface";
		#sound-dai-cells = <0x00>;
		sound-name-prefix = "TDM_B";
		clocks = <0x14 0x50 0x14 0x57 0x14 0x32>;
		clock-names = "sclk", "lrclk", "mclk";
		status = "okay";
		pinctrl-0 = <0x4c 0x4d 0x4e 0x4f>;
		pinctrl-names = "default";
		assigned-clocks = <0x14 0x9b 0x14 0xa1 0x14 0x9e>;
		assigned-clock-parents = <0x14 0x32 0x14 0x50 0x14 0x57>;
		assigned-clock-rates = <0x00 0x00 0x00>;
		phandle = <0x69>;
	};

	tdmif_c: audio-controller-2 {
		compatible = "amlogic,axg-tdm-iface";
		#sound-dai-cells = <0x00>;
		sound-name-prefix = "TDM_C";
		clocks = <0x14 0x51 0x14 0x58 0x14 0x33>;
		clock-names = "sclk", "lrclk", "mclk";
		status = "okay";
		phandle = <0x6a>;
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00 0x00>;
			enable-method = "psci";
			d-cache-line-size = <0x20>;
			d-cache-size = <0x8000>;
			d-cache-sets = <0x20>;
			i-cache-line-size = <0x20>;
			i-cache-size = <0x8000>;
			i-cache-sets = <0x20>;
			next-level-cache = <0x50>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x51>;
			operating-points-v2 = <0x52>;
			clocks = <0x02 0xbb>;
			phandle = <0x41>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00 0x01>;
			enable-method = "psci";
			d-cache-line-size = <0x20>;
			d-cache-size = <0x8000>;
			d-cache-sets = <0x20>;
			i-cache-line-size = <0x20>;
			i-cache-size = <0x8000>;
			i-cache-sets = <0x20>;
			next-level-cache = <0x50>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x51>;
			operating-points-v2 = <0x52>;
			clocks = <0x02 0xbb>;
			phandle = <0x42>;
		};

		cpu2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00 0x02>;
			enable-method = "psci";
			d-cache-line-size = <0x20>;
			d-cache-size = <0x8000>;
			d-cache-sets = <0x20>;
			i-cache-line-size = <0x20>;
			i-cache-size = <0x8000>;
			i-cache-sets = <0x20>;
			next-level-cache = <0x50>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x51>;
			operating-points-v2 = <0x52>;
			clocks = <0x02 0xbb>;
			phandle = <0x43>;
		};

		cpu3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00 0x03>;
			enable-method = "psci";
			d-cache-line-size = <0x20>;
			d-cache-size = <0x8000>;
			d-cache-sets = <0x20>;
			i-cache-line-size = <0x20>;
			i-cache-size = <0x8000>;
			i-cache-sets = <0x20>;
			next-level-cache = <0x50>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x51>;
			operating-points-v2 = <0x52>;
			clocks = <0x02 0xbb>;
			phandle = <0x44>;
		};

		l2: l2-cache0 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x80000>;
			cache-line-size = <0x40>;
			cache-sets = <0x200>;
			phandle = <0x50>;
		};
	};

	cpu_opp_table: opp-table {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x52>;

		opp-1000000000 {
			opp-hz = <0x00 0x3b9aca00>;
			opp-microvolt = <0xb2778>;
			clock-latency-ns = <0xc350>;
		};

		opp-1200000000 {
			opp-hz = <0x00 0x47868c00>;
			opp-microvolt = <0xb2778>;
		};

		opp-1398000000 {
			opp-hz = <0x00 0x5353c980>;
			opp-microvolt = <0xb9ca8>;
		};

		opp-1512000000 {
			opp-hz = <0x00 0x5a1f4a00>;
			opp-microvolt = <0xc11d8>;
		};

		opp-1608000000 {
			opp-hz = <0x00 0x5fd82200>;
			opp-microvolt = <0xcae18>;
		};

		opp-1704000000 {
			opp-hz = <0x00 0x6590fa00>;
			opp-microvolt = <0xd2348>;
		};

		opp-1800000000 {
			opp-hz = <0x00 0x6b49d200>;
			opp-microvolt = <0xef808>;
		};

		opp-100000000 {
			status = "disabled";
		};

		opp-250000000 {
			status = "disabled";
		};

		opp-500000000 {
			status = "disabled";
		};

		opp-667000000 {
			status = "disabled";
		};

		opp-1908000000 {
			opp-hz = <0x00 0x71b9c500>;
			opp-microvolt = <0xf4628>;
		};
	};

	dioo2133: audio-amplifier-0 {
		compatible = "simple-audio-amplifier";
		enable-gpios = <0x53 0x02 0x00>;
		VCC-supply = <0x0b>;
		sound-name-prefix = "10U2";
		phandle = <0x5f>;
	};

	spdif_dir: audio-codec-0 {
		compatible = "linux,spdif-dir";
		#sound-dai-cells = <0x00>;
		sound-name-prefix = "DIR";
		phandle = <0x70>;
	};

	spdif_dit: audio-codec-1 {
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0x00>;
		sound-name-prefix = "DIT";
		phandle = <0x6c>;
	};

	cvbs-connector {
		compatible = "composite-video-connector";

		port {

			cvbs_connector_in: endpoint {
				remote-endpoint = <0x54>;
				phandle = <0x21>;
			};
		};
	};

	emmc_pwrseq: emmc-pwrseq {
		compatible = "mmc-pwrseq-emmc";
		reset-gpios = <0x32 0x25 0x01>;
		phandle = <0x37>;
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {

			hdmi_connector_in: endpoint {
				remote-endpoint = <0x55>;
				phandle = <0x0d>;
			};
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00 0x00 0x01 0x00000000>;
	};

	flash_1v8: regulator-flash-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "FLASH_1V8";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		vin-supply = <0x38>;
		regulator-always-on;
		phandle = <0x39>;
	};

	main_12v: regulator-main-12v {
		compatible = "regulator-fixed";
		regulator-name = "12V";
		regulator-min-microvolt = <0xb71b00>;
		regulator-max-microvolt = <0xb71b00>;
		regulator-always-on;
		phandle = <0x56>;
	};

	usb_pwr_en: regulator-usb-pwr-en {
		compatible = "regulator-fixed";
		regulator-name = "USB_PWR_EN";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <0x0b>;
		gpio = <0x32 0x16 0x00>;
		enable-active-high;
		phandle = <0x3c>;
	};

	vcc_1v8: regulator-vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "VCC_1V8";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		vin-supply = <0x38>;
		regulator-always-on;
		phandle = <0x140>;
	};

	vcc_3v3: regulator-vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VCC_3V3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <0x2f>;
		regulator-always-on;
		phandle = <0x38>;
	};

	vcc_5v: regulator-vcc-5v {
		compatible = "regulator-fixed";
		regulator-name = "VCC_5V";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <0x56>;
		gpio = <0x32 0x18 0x06>;
		enable-active-high;
		phandle = <0x0b>;
	};

	vddao_1v8: regulator-vddao-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "VDDAO_1V8";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		vin-supply = <0x2f>;
		regulator-always-on;
		phandle = <0x0e>;
	};

	vddao_3v3: regulator-vddao-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VDDAO_3V3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <0x56>;
		regulator-always-on;
		phandle = <0x2f>;
	};

	vddcpu: regulator-vddcpu {
		compatible = "pwm-regulator";
		regulator-name = "VDDCPU";
		regulator-min-microvolt = <0xb0068>;
		regulator-max-microvolt = <0xf9830>;
		pwm-supply = <0x56>;
		pwms = <0x57 0x01 0x4e2 0x00>;
		pwm-dutycycle-range = <0x64 0x00>;
		regulator-boot-on;
		regulator-always-on;
		phandle = <0x51>;
	};

	sound {
		compatible = "amlogic,axg-sound-card";
		model = "U200";
		audio-widgets = "Line", "Lineout";
		audio-aux-devs = <0x58 0x59 0x5a 0x5b 0x5c 0x5d 0x5e 0x5f>;
		audio-routing = "TDMOUT_A IN 0", "FRDDR_A OUT 0", "TDMOUT_A IN 1", "FRDDR_B OUT 0", "TDMOUT_A IN 2", "FRDDR_C OUT 0", "TDM_A Playback", "TDMOUT_A OUT", "TDMOUT_B IN 0", "FRDDR_A OUT 1", "TDMOUT_B IN 1", "FRDDR_B OUT 1", "TDMOUT_B IN 2", "FRDDR_C OUT 1", "TDM_B Playback", "TDMOUT_B OUT", "TDMOUT_C IN 0", "FRDDR_A OUT 2", "TDMOUT_C IN 1", "FRDDR_B OUT 2", "TDMOUT_C IN 2", "FRDDR_C OUT 2", "TDM_C Playback", "TDMOUT_C OUT", "SPDIFOUT_A IN 0", "FRDDR_A OUT 3", "SPDIFOUT_A IN 1", "FRDDR_B OUT 3", "SPDIFOUT_A IN 2", "FRDDR_C OUT 3", "SPDIFOUT_B IN 0", "FRDDR_A OUT 4", "SPDIFOUT_B IN 1", "FRDDR_B OUT 4", "SPDIFOUT_B IN 2", "FRDDR_C OUT 4", "TDMIN_A IN 0", "TDM_A Capture", "TDMIN_A IN 1", "TDM_B Capture", "TDMIN_A IN 2", "TDM_C Capture", "TDMIN_A IN 3", "TDM_A Loopback", "TDMIN_A IN 4", "TDM_B Loopback", "TDMIN_A IN 5", "TDM_C Loopback", "TDMIN_B IN 0", "TDM_A Capture", "TDMIN_B IN 1", "TDM_B Capture", "TDMIN_B IN 2", "TDM_C Capture", "TDMIN_B IN 3", "TDM_A Loopback", "TDMIN_B IN 4", "TDM_B Loopback", "TDMIN_B IN 5", "TDM_C Loopback", "TDMIN_C IN 0", "TDM_A Capture", "TDMIN_C IN 1", "TDM_B Capture", "TDMIN_C IN 2", "TDM_C Capture", "TDMIN_C IN 3", "TDM_A Loopback", "TDMIN_C IN 4", "TDM_B Loopback", "TDMIN_C IN 5", "TDM_C Loopback", "TDMIN_LB IN 3", "TDM_A Capture", "TDMIN_LB IN 4", "TDM_B Capture", "TDMIN_LB IN 5", "TDM_C Capture", "TDMIN_LB IN 0", "TDM_A Loopback", "TDMIN_LB IN 1", "TDM_B Loopback", "TDMIN_LB IN 2", "TDM_C Loopback", "TODDR_A IN 0", "TDMIN_A OUT", "TODDR_B IN 0", "TDMIN_A OUT", "TODDR_C IN 0", "TDMIN_A OUT", "TODDR_A IN 1", "TDMIN_B OUT", "TODDR_B IN 1", "TDMIN_B OUT", "TODDR_C IN 1", "TDMIN_B OUT", "TODDR_A IN 2", "TDMIN_C OUT", "TODDR_B IN 2", "TDMIN_C OUT", "TODDR_C IN 2", "TDMIN_C OUT", "TODDR_A IN 3", "SPDIFIN Capture", "TODDR_B IN 3", "SPDIFIN Capture", "TODDR_C IN 3", "SPDIFIN Capture", "TODDR_A IN 6", "TDMIN_LB OUT", "TODDR_B IN 6", "TDMIN_LB OUT", "TODDR_C IN 6", "TDMIN_LB OUT\bU2 INL", "ACODEC LOLP\bU2 INR", "ACODEC LORP", "Lineout\bU2 OUTL", "Lineout\bU2 OUTR";
		clocks = <0x02 0x0d 0x02 0x0b 0x02 0x0c>;
		assigned-clocks = <0x02 0x0d 0x02 0x0b 0x02 0x0c>;
		assigned-clock-parents = <0x00 0x00 0x00>;
		assigned-clock-rates = <0x11940000 0x10266000 0x17700000>;

		dai-link-0 {
			sound-dai = <0x60>;
		};

		dai-link-1 {
			sound-dai = <0x61>;
		};

		dai-link-2 {
			sound-dai = <0x62>;
		};

		dai-link-3 {
			sound-dai = <0x63>;
		};

		dai-link-4 {
			sound-dai = <0x64>;
		};

		dai-link-5 {
			sound-dai = <0x65>;
		};

		dai-link-6 {
			sound-dai = <0x66>;
			dai-format = "dsp_a";
			dai-tdm-slot-tx-mask-0 = <0x01 0x01>;
			mclk-fs = <0x100>;

			codec-0 {
				sound-dai = <0x67 0x00>;
			};

			codec-1 {
				sound-dai = <0x68 0x00>;
			};
		};

		dai-link-7 {
			sound-dai = <0x69>;
			dai-format = "i2s";
			dai-tdm-slot-tx-mask-0 = <0x01 0x01>;
			mclk-fs = <0x100>;

			codec-0 {
				sound-dai = <0x67 0x01>;
			};

			codec-1 {
				sound-dai = <0x68 0x01>;
			};
		};

		dai-link-8 {
			sound-dai = <0x6a>;
			dai-format = "i2s";
			dai-tdm-slot-tx-mask-0 = <0x01 0x01>;
			dai-tdm-slot-tx-mask-1 = <0x01 0x01>;
			dai-tdm-slot-tx-mask-2 = <0x01 0x01>;
			dai-tdm-slot-tx-mask-3 = <0x01 0x01>;
			mclk-fs = <0x100>;

			codec-0 {
				sound-dai = <0x67 0x02>;
			};

			codec-1 {
				sound-dai = <0x68 0x02>;
			};
		};

		dai-link-9 {
			sound-dai = <0x6b>;

			codec-0 {
				sound-dai = <0x6c>;
			};

			codec-1 {
				sound-dai = <0x68 0x04>;
			};
		};

		dai-link-10 {
			sound-dai = <0x6d>;

			codec {
				sound-dai = <0x68 0x05>;
			};
		};

		dai-link-11 {
			sound-dai = <0x68 0x03>;

			codec {
				sound-dai = <0x1b>;
			};
		};

		dai-link-12 {
			sound-dai = <0x67 0x03>;

			codec {
				sound-dai = <0x6e>;
			};
		};

		dai-link-13 {
			sound-dai = <0x6f>;

			codec {
				sound-dai = <0x70>;
			};
		};
	};

	vddgpu: regulator-vddgpu {
		compatible = "regulator-fixed";
		regulator-name = "mali";
		regulator-min-microvolt = "", "\f5";
		regulator-max-microvolt = "", "\f5";
		vin-supply = <0x56>;
		regulator-boot-on;
		regulator-always-on;
		phandle = <0x3e>;
	};

	wifi32k: wifi32k {
		compatible = "pwm-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x8000>;
		pwms = <0x71 0x00 0x7736 0x00>;
		phandle = <0x72>;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <0x32 0x47 0x01>;
		phandle = <0x2e>;
	};

	leds {
		compatible = "gpio-leds";

		power_led {
			led_name = "power_led";
			gpios = <0x53 0x0b 0x01>;
			default-state = "on";
		};

		net_led {
			led_name = "net_led";
			gpios = <0x53 0x09 0x01>;
			default-state = "off";
			linux,default-trigger = "0.0:00:link";
		};

		remote_led {
			led_name = "remote_led";
			gpios = <0x53 0x0a 0x01>;
			default-state = "off";
			linux,default-trigger = "rc-feedback";
		};
	};

