			vrtc: rtc@a8 {
				compatible = "amlogic,meson-vrtc";
				reg = <0x00 0xa8 0x00 0x04>;
				phandle = <0x114>;
			};

			cec_AO: cec@100 {
				compatible = "amlogic,meson-gx-ao-cec";
				reg = <0x00 0x100 0x00 0x14>;
				interrupts = <0x00 0xc7 0x01>;
				clocks = <0x19 0x1b>;
				clock-names = "core";
				status = "disabled";
				pinctrl-0 = <0x1a>;
				pinctrl-names = "default";
				hdmi-phandle = <0x1b>;
				phandle = <0x115>;
			};

			sec_AO: ao-secure@140 {
				compatible = "amlogic,meson-gx-ao-secure", "syscon";
				reg = <0x00 0x140 0x00 0x140>;
				amlogic,has-chip-id;
				phandle = <0x10>;
			};

			cecb_AO: cec@280 {
				compatible = "amlogic,meson-g12a-ao-cec";
				reg = <0x00 0x280 0x00 0x1c>;
				interrupts = <0x00 0xcb 0x01>;
				clocks = <0x19 0x13>;
				clock-names = "oscin";
				status = "okay";
				pinctrl-0 = <0x1c>;
				pinctrl-names = "default";
				hdmi-phandle = <0x1b>;
				phandle = <0x116>;
			};

			pwm_AO_cd: pwm@2000 {
				compatible = "amlogic,meson-g12-pwm-v2", "amlogic,meson8-pwm-v2";
				reg = <0x00 0x2000 0x00 0x20>;
				clocks = <0x08 0x19 0x0f>;
				#pwm-cells = <0x03>;
				status = "okay";
				pinctrl-0 = <0x1d>;
				pinctrl-names = "default";
				phandle = <0x57>;
			};

			uart_AO: serial@3000 {
				compatible = "amlogic,meson-g12a-uart", "amlogic,meson-gx-uart", "amlogic,meson-ao-uart";
				reg = <0x00 0x3000 0x00 0x18>;
				interrupts = <0x00 0xc1 0x01>;
				clocks = <0x08 0x19 0x04 0x08>;
				clock-names = "xtal", "pclk", "baud";
				status = "okay";
				pinctrl-0 = <0x1e>;
				pinctrl-names = "default";
				phandle = <0x117>;
			};

			uart_AO_B: serial@4000 {
				compatible = "amlogic,meson-g12a-uart", "amlogic,meson-gx-uart", "amlogic,meson-ao-uart";
				reg = <0x00 0x4000 0x00 0x18>;
				interrupts = <0x00 0xc5 0x01>;
				clocks = <0x08 0x19 0x06 0x08>;
				clock-names = "xtal", "pclk", "baud";
