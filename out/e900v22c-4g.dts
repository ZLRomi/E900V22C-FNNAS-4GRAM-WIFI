		vdec: video-decoder@ff620000 {
			compatible = "amlogic,g12a-vdec";
			reg = <0x00 0xff620000 0x00 0x10000 0x00 0xffd0e180 0x00 0xe4>;
			reg-names = "dos", "esparser";
			interrupts = <0x00 0x2c 0x01 0x00 0x20 0x01>;
			interrupt-names = "vdec", "esparser";
			amlogic,ao-sysctrl = <0x11>;
			amlogic,canvas = <0x20>;
			clocks = <0x02 0x2e 0x02 0x10 0x02 0xcc 0x02 0xcf 0x02 0xd2>;
			clock-names = "dos_parser", "dos", "vdec_1", "vdec_hevc", "vdec_hevcf";
			resets = <0x05 0x28>;
			reset-names = "esparser";
			phandle = <0x11d>;
		};

		vpu: vpu@ff900000 {
			compatible = "amlogic,meson-g12a-vpu";
			reg = <0x00 0xff900000 0x00 0x100000 0x00 0xff63c000 0x00 0x1000>;
			reg-names = "vpu", "hhi";
			interrupts = <0x00 0x03 0x01>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			amlogic,canvas = <0x20>;
			power-domains = <0x03 0x00>;
			phandle = <0x11e>;

			cvbs_vdac_port: port@0 {
				reg = <0x00>;
				phandle = <0x11f>;

				cvbs_vdac_out: endpoint {
					remote-endpoint = <0x21>;
					phandle = <0x54>;
				};
			};

			hdmi_tx_port: port@1 {
				reg = <0x01>;
				phandle = <0x120>;

				hdmi_tx_out: endpoint {
					remote-endpoint = <0x22>;
					phandle = <0x0c>;
				};
			};

			dpi_port: port@2 {
				reg = <0x02>;
				phandle = <0x121>;

				dpi_out: endpoint {
					remote-endpoint = <0x23>;
					phandle = <0x25>;
				};
			};
		};

		gic: interrupt-controller@ffc01000 {
			compatible = "arm,gic-400";
			reg = <0x00 0xffc01000 0x00 0x1000 0x00 0xffc02000 0x00 0x2000 0x00 0xffc04000 0x00 0x2000 0x00 0xffc06000 0x00 0x2000>;
			interrupt-controller;
			interrupts = <0x01 0x09 0xff04>;
			#interrupt-cells = <0x03>;
			#address-cells = <0x00>;
			phandle = <0x01>;
		};

		cbus: bus@ffd00000 {
			compatible = "simple-bus";
			reg = <0x00 0xffd00000 0x00 0x100000>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges = <0x00 0x00 0x00 0xffd00000 0x00 0x100000>;
			phandle = <0x122>;

			reset: reset-controller@1004 {
				compatible = "amlogic,meson-axg-reset";
				reg = <0x00 0x1004 0x00 0x9c>;
				#reset-cells = <0x01>;
				phandle = <0x05>;
			};

			gpio_intc: interrupt-controller@f080 {
				compatible = "amlogic,meson-g12a-gpio-intc", "amlogic,meson-gpio-intc";
				reg = <0x00 0xf080 0x00 0x10>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				amlogic,channel-interrupts = <0x40 0x41 0x42 0x43 0x44 0x45 0x46 0x47>;
				phandle = <0x123>;
			};

			mipi_dsi: dsi@7000 {
				compatible = "amlogic,meson-g12a-dw-mipi-dsi";
				reg = <0x00 0x7000 0x00 0x1000>;
				resets = <0x05 0x44>;
				reset-names = "top";
				clocks = <0x02 0x12 0x02 0x10e 0x02 0x10f>;
				clock-names = "pclk", "bit", "px";
				phys = <0x24>;
				phy-names = "dphy";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "disabled";
				assigned-clocks = <0x02 0x10d 0x02 0x110 0x02 0x85>;
				assigned-clock-parents = <0x02 0x07 0x02 0x99 0x02 0x07>;
				phandle = <0x124>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					mipi_dsi_venc_port: port@0 {
						reg = <0x00>;
						phandle = <0x125>;

						mipi_dsi_in: endpoint {
							remote-endpoint = <0x25>;
							phandle = <0x23>;
						};
					};

					mipi_dsi_panel_port: port@1 {
						reg = <0x01>;
						phandle = <0x126>;
					};
				};
			};

